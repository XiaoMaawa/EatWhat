# 统一换行与文本处理规则
# 详见 https://git-scm.com/docs/gitattributes

# ---------- 默认：自动检测文本文件并规范换行 ----------
* text=auto eol=lf

# ---------- 明确为文本的文件 ----------
*.java      text diff=java
*.xml       text diff=java
*.yml       text
*.yaml      text
*.properties text
*.sql       text
*.md        text diff=markdown
*.json      text
*.js        text
*.mjs       text
*.cjs       text
*.ts        text
*.vue       text
*.html      text
*.css       text
*.scss      text
*.less      text
*.sh        text eol=lf
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf
Dockerfile  text
.gitignore  text
.gitattributes text
.editorconfig  text

# ---------- 明确为二进制的文件 ----------
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.webp      binary
*.svg       text
*.pdf       binary
*.docx      binary
*.doc       binary
*.xlsx      binary
*.xls       binary
*.pptx      binary
*.ppt       binary
*.zip       binary
*.gz        binary
*.jar       binary
*.woff      binary
*.woff2     binary
*.ttf       binary
*.eot       binary

# ---------- 语言统计：排除文档与依赖 ----------
docs/**     linguist-documentation
*.md        linguist-documentation
