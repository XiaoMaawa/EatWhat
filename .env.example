# ============================================================
# “吃了么”外卖平台 —— 环境变量示例
#
# 用法：
#   1. 复制本文件为 .env.local（已被 .gitignore 排除，不会入库）
#   2. 按实际环境填写值
#   3. 通过 IDE 运行配置、启动脚本或 shell export 注入
#
# 注意：本文件中的值均为示例占位，切勿在仓库中填写真实密码与密钥。
# ============================================================

# ---------- 数据库 ----------
# 主机地址，默认 localhost
DB_HOST=localhost
# 端口，默认 3306
DB_PORT=3306
# 数据库名，默认 eatwhat（需先执行 sql/init.sql 建库建表）
DB_NAME=eatwhat
# 用户名
DB_USERNAME=root
# 密码（生产环境务必使用强密码）
DB_PASSWORD=

# ---------- JWT ----------
# 签名密钥，必须 ≥32 字节；生产环境请替换为随机生成的长字符串
# 生成示例：openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-secret-at-least-32-bytes

# 访问令牌有效期（毫秒），默认 7200000（2 小时）
JWT_EXPIRATION=7200000

# ---------- 文件上传 ----------
# 上传根目录，默认 ./data/upload（相对后端工作目录）
UPLOAD_PATH=./data/upload
